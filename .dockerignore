# The image gets the repo (src/ + data/ + pyproject), not the working directory's local state.
# Secrets first: a local .env holds real credentials and must never be baked into an image.
.env
.venv
.git
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
runs/
*.log
results*.json
# Local-only mining artifacts (see .gitignore): large, and keyed by unpublished internal ids.
data/itsmbench/trajectories/
data/itsmbench/task_id_map.json
